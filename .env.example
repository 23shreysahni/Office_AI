# Copy to .env. No credentials belong in this file.
# Actual host/network values are mandatory; examples are deliberately incomplete.
OFFICE_HOSTNAME=office-ai.internal
LAN_BIND_IP=
# Space-separated private IPv4 CIDRs; include the approved VPN range if used.
LAN_ALLOWED_CIDRS=
COMPOSE_PROJECT_NAME=office-ai
MODEL_NAME=qwen3.5:9b
# auto probes local container GPU support; nvidia requires it; cpu disables it.
COMPUTE_MODE=auto
# Complete sha256:<64 hex> from the locally installed model, not a catalogue hash.
MODEL_DIGEST=
# Candidate limits only: measure against actual server RAM/CPU before deployment.
OLLAMA_MEMORY=12g
WEBUI_MEMORY=4g
OLLAMA_CPUS=4
WEBUI_CPUS=2
# Set true only after host ingress AND Docker forwarding/egress rules are reviewed.
NETWORK_POLICY_REVIEWED=false
