# Rendered by the JavaScript preflight, not by shell/envsubst.
user root;
worker_processes 1;
worker_shutdown_timeout 5s;
pid /tmp/nginx.pid;
error_log stderr crit;
events { worker_connections 256; }
http {
    map_hash_bucket_size 128;
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 120s;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $uri $login_rate_key {
        default "";
        /api/v1/auths/signin $binary_remote_addr;
        /api/v1/auths/signup $binary_remote_addr;
    }
    limit_req_zone $login_rate_key zone=login:1m rate=5r/m;
    # First matching regex wins. Restrict methods as well as paths.
    map "$request_method:$uri" $phase1_allowed {
        default 0;
        "POST:/api/v1/auths/signup" __SIGNUP_ALLOWED__;
        ~^\w+:/api/v1/chats/.*(share|import|config|resolve|compact|clone) 0;
        "~^GET:/(health|api/config|api/version|api/changelog|api/models|api/v1/auths/|api/v1/users/user/settings/?|api/tasks|ollama/api/(tags|version|ps))$" 1;
        ~^GET:/api/v1/ 1;
        ~^GET:/api/v1/users/[^/]+/profile/image$ 1;
        ~^GET:/api/v1/(configs/banners|tools/?|notes/pinned|folders(/shared)?)$ 1;
        ~^GET:/api/v1/chats(/.*)?$ 1;
        ~^GET:/api/tasks/chat/ 1;
        "~^POST:/(api/v1/auths/(signin|signout|update/password)|api/chat/(completions|completed)|api/v1/users/user/settings/update|ollama/api/show)$" 1;
        ~^POST:/api/v1/auths/update/timezone$ 1;
        ~^POST:/api/v1/chats/ 1;
        ~^POST:/api/tasks/stop/ 1;
        ~^POST:/api/tasks/chat/.*/stop$ 1;
        ~^DELETE:/api/v1/chats/ 1;
        ~^(GET|POST):/ws/ 1;
        "~^(GET|HEAD):/(?!api(?:/|$)|ollama(?:/|$)|openai(?:/|$)|oauth(?:/|$)|cache(?:/|$)|docs(?:/|$)|redoc(?:/|$)|openapi[.]json$)" 1;
    }
    upstream office_ui { server webui:8080; keepalive 8; }
    server {
        listen 443 ssl default_server;
        server_name __HOSTNAME__;
        ssl_certificate /run/secrets/tls_certificate;
        ssl_certificate_key /run/secrets/tls_private_key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        ssl_session_cache shared:TLS:10m;
        __ALLOW_RULES__
        deny all;
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        if ($host != "__HOSTNAME__") { return 421; }
        if ($phase1_allowed = 0) { return 403; }
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        location / {
            proxy_pass http://office_ui;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-User "";
            proxy_set_header X-Forwarded-Email "";
            proxy_set_header X-Auth-Request-Email "";
            proxy_set_header Remote-User "";
            proxy_set_header X-API-Key "";
            proxy_connect_timeout 5s;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_max_temp_file_size 0;
            proxy_next_upstream off;
        }
    }
}
