  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-office_session",
        "description": "Opaque server-side session; Secure, HttpOnly, Path=/, SameSite=Lax, no Domain. Hashed at rest; current grants checked per request."
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Server-session-bound token, required with exact approved Origin for state changes."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "requestId"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorised",
              "forbidden",
              "not_found",
              "invalid_request",
              "conflict",
              "rate_limited",
              "unavailable"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "issuer",
          "subject",
          "active",
          "roles",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "active": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "platform_admin",
                "editorial_user",
                "hr_user",
                "sales_user",
                "accounts_user",
                "accounts_approver"
              ]
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "UserPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
