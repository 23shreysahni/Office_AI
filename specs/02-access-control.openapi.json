{
  "openapi": "3.1.0",
  "info": {
    "title": "Local Office AI Phase 2 access API",
    "version": "0.1.0-draft",
    "description": "Review draft only; NOT IMPLEMENTED. Same-origin internal HTTPS API. No public registration, passwords, document ingestion, retrieval or financial operations. All protected responses are no-store. Every mutation requires the fixed HTTPS Origin plus session-bound X-CSRF-Token. Unknown properties/query parameters and JSON above 16 KiB are rejected. Public login/callback use separate one-use OIDC transaction controls. API bearer tokens and upstream WebUI cookies are not accepted."
  },
  "servers": [
    {
      "url": "https://office-ai.internal",
      "description": "Placeholder only; replace with the approved private DNS origin."
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Non-sensitive readiness only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/access/login": {
      "get": {
        "operationId": "beginLogin",
        "security": [],
        "description": "Start fixed internal-provider authorisation-code/PKCE flow. No issuer or return URL input. Rate limited; one-use browser-bound state/nonce transaction.",
        "responses": {
          "302": {
            "description": "Redirect to the approved provider; no-store and a short-lived Secure/HttpOnly transaction cookie."
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/access/callback": {
      "get": {
        "operationId": "finishLogin",
        "security": [],
        "description": "Validate provider response, transaction cookie, state, nonce, PKCE and token claims before creating a local session for a pre-enrolled active subject. Reject error/replayed/unknown query parameters; never log callback query values.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect only to /access/ with rotated host-only Secure/HttpOnly/SameSite=Lax session cookie; no-store."
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorised"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/access/session": {
      "get": {
        "operationId": "currentSession",
        "description": "Current local identity/roles only; no provider token.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorised"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/access/csrf": {
      "get": {
        "operationId": "csrfToken",
        "description": "Return the current server-session-bound CSRF token; no-store.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorised"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/access/logout": {
      "post": {
        "operationId": "logout",
        "description": "Revoke local session and expire cookie even when provider logout is unavailable.",
        "responses": {
          "204": {
            "description": "Session revoked; cookie expired."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorised"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ]
      }
    },
    "/api/access/collections": {
      "get": {
